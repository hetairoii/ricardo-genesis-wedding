---
import { Image } from 'astro:assets';
import ornamentalDividerTop from '../assets/ornamental-divider-top.png';
import ornamentalDividerBottom from '../assets/ornamental-divider-bottom.png';
import flowersCornerTopRight from '../assets/flowers-cornered-right-top.png';
import flowersCornerBottomLeft from '../assets/flowers-cornered-left-bottom.png';

type Variant = 'top' | 'bottom' | 'corner-top-right' | 'corner-bottom-left';

interface Props {
	class?: string;
	variant?: Variant;
}

const { class: className, variant = 'top' } = Astro.props;

/*
	Techo de tamaño ligado a la resolución fuente (mismo criterio que Fecha.astro): en pantallas
	retina/2x el navegador necesita 2px reales por cada px CSS, así que el máximo sin perder
	nitidez es (ancho del archivo) / 2.
	- flowers-cornered-right-top.png es 500x500 -> tope 250px.
	- flowers-cornered-left-bottom.png es 1024x1024 (mayor resolución) -> tope 500px.
*/
const variants: Record<Variant, { src: ImageMetadata; class: string }> = {
	top: { src: ornamentalDividerTop, class: 'mx-auto h-auto w-40 sm:w-48' },
	bottom: { src: ornamentalDividerBottom, class: 'mx-auto h-auto w-40 sm:w-48' },
	'corner-top-right': {
		src: flowersCornerTopRight,
		class: 'absolute top-0 right-0 h-auto w-24 sm:w-36 md:w-56 lg:max-w-[250px]',
	},
	'corner-bottom-left': {
		src: flowersCornerBottomLeft,
		class: 'absolute bottom-0 left-0 h-auto w-28 sm:w-44 md:w-72 lg:max-w-[500px]',
	},
};

const { src, class: variantClass } = variants[variant];
---

<Image
	src={src}
	alt=""
	class:list={[variantClass, className]}
	aria-hidden="true"
	role="presentation"
/>
