---
import { Image } from 'astro:assets';
import ornamentalDividerTop from '../assets/ornamental-divider-top.png';
import ornamentalDividerBottom from '../assets/ornamental-divider-bottom.png';
import flowersCornerTopRight from '../assets/flowers-cornered-right-top.png';
import flowersCornerBottomLeft from '../assets/flowers-cornered-left-bottom.png';
import flowersLateralLeft from '../assets/flowers-lateral-left.png';
import flowersLateralRight from '../assets/flowers-lateral-right.png';

type Variant = 'top' | 'bottom' | 'corner-top-right' | 'corner-bottom-left' | 'lateral-left' | 'lateral-right';

interface Props {
	class?: string;
	variant?: Variant;
	/** Refleja horizontalmente el ramo de esquina y lo pasa a la esquina opuesta (misma imagen,
	 *  sin duplicar assets), para variar de qué lado aparecen las flores entre secciones. */
	mirror?: boolean;
}

const { class: className, variant = 'top', mirror = false } = Astro.props;

/*
	Techo de tamaño ligado a la resolución fuente (mismo criterio que Fecha.astro): en pantallas
	retina/2x el navegador necesita 2px reales por cada px CSS, así que el máximo sin perder
	nitidez es (ancho del archivo) / 2.
	- flowers-cornered-right-top.png es 500x500 -> tope 250px.
	- flowers-cornered-left-bottom.png es 1024x1024 (mayor resolución) -> tope 500px.
*/
const variants: Record<Variant, { src: ImageMetadata; size: string; position: string; mirrorPosition: string }> = {
	top: { src: ornamentalDividerTop, size: 'mx-auto h-auto w-40 sm:w-48', position: '', mirrorPosition: '' },
	bottom: { src: ornamentalDividerBottom, size: 'mx-auto h-auto w-40 sm:w-48', position: '', mirrorPosition: '' },
	'corner-top-right': {
		src: flowersCornerTopRight,
		size: 'h-auto w-24 sm:w-36 md:w-56 lg:max-w-[250px]',
		position: 'absolute top-0 right-0',
		mirrorPosition: 'absolute top-0 left-0',
	},
	'corner-bottom-left': {
		src: flowersCornerBottomLeft,
		size: 'h-auto w-28 sm:w-44 md:w-72 lg:max-w-[500px]',
		position: 'absolute bottom-0 left-0',
		mirrorPosition: 'absolute bottom-0 right-0',
	},
	'lateral-left': {
		src: flowersLateralLeft,
		size: 'h-auto w-24 sm:w-36 md:w-56 lg:max-w-[250px]',
		position: 'absolute left-0 top-1/2 -translate-y-1/2',
		mirrorPosition: 'absolute right-0 top-1/2 -translate-y-1/2',
	},
	'lateral-right': {
		src: flowersLateralRight,
		size: 'h-auto w-24 sm:w-36 md:w-56 lg:max-w-[250px]',
		position: 'absolute right-0 top-1/2 -translate-y-1/2',
		mirrorPosition: 'absolute left-0 top-1/2 -translate-y-1/2',
	},
};

const { src, size, position, mirrorPosition } = variants[variant];
const positionClass = mirror ? mirrorPosition : position;
const mirrorClass = mirror ? '-scale-x-100' : '';
---

<Image
	src={src}
	alt=""
	class:list={[size, positionClass, mirrorClass, className]}
	aria-hidden="true"
	role="presentation"
/>
