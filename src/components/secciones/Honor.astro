---
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import { honorNote } from '../../data/wedding';
---

<Section id="honor" background="ivory" variant="fade-right" class="relative overflow-hidden">
	<Ornament variant="lateral-left" class="opacity-80" />
	<Ornament variant="lateral-right" class="opacity-80" />

	<Ornament class="relative mb-8" variant="top" />

	<div class="relative mx-auto max-w-[55ch] text-center">
		<p class="font-serif text-xl leading-relaxed text-ink italic md:text-2xl">
			{honorNote.intro}
		</p>
		<p class="mt-6 font-serif text-2xl text-dusty md:text-4xl">
			{honorNote.title}
		</p>
		<p class="mt-6 font-serif text-xl leading-relaxed text-ink italic md:text-2xl">
			{honorNote.closing}
		</p>
	</div>

	<Ornament class="relative mt-8" variant="bottom" />
</Section>
