---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import PhotoCard from '../contenedores/PhotoCard.astro';
import catholicCross from '../../assets/catholic-cross.png';
import { couple, gratitudNote } from '../../data/wedding';
import manosAnillo from '../../assets/fotos-boda/manos-anillo.jpg';
---

<Section id="gratitud" background="ivory" class="relative overflow-hidden">
	<Ornament variant="corner-top-right" class="opacity-90" />
	<Ornament variant="corner-bottom-left" class="opacity-90" />

	<Image src={catholicCross} alt="" class="relative mx-auto mb-6 h-16 w-auto" />

	<Ornament class="relative mb-8" variant="top" />

	<div class="relative mx-auto max-w-[65ch] rounded-sm bg-deep px-6 py-10 sm:px-12 sm:py-14">
		<p class="text-center font-serif text-lg leading-relaxed text-white italic md:text-2xl">
			{gratitudNote.body}<br>
			<span class="font-serif text-2xl font-semibold text-champagne italic md:text-4xl">{gratitudNote.highlight}</span>.
		</p>
	</div>

	<!--
		Foto apaisada bajo la cita: corta el bloque azul de texto, que era el muro más largo
		de la parte alta de la invitación, y da el primer respiro visual después del hero.
		Va con margen negativo para solaparse con el borde inferior del bloque, como una foto
		apoyada sobre la tarjeta y no como una fila más de la sección. El solape se queda en
		16px (menos que el padding inferior del bloque, 40px en móvil) para que muerda el borde
		azul sin llegar a pegarse a la última línea de la cita.
	-->
	<div class="relative mx-auto -mt-4 w-[min(20rem,78%)]">
		<PhotoCard
			src={manosAnillo}
			alt={`Manos entrelazadas de ${couple.groomFirstName} y ${couple.brideFirstName} con el anillo de compromiso`}
			ratio="landscape"
			tone="gold"
			bw
			caption="Nuestra historia"
		/>
	</div>

	<Ornament class="relative mt-8" variant="bottom" />
</Section>
