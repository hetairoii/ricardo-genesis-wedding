---
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import { parents } from '../../data/wedding';

const showGroomParents = parents.groom.length > 0;
const showBrideParents = parents.bride.length > 0;
const showParents = showGroomParents || showBrideParents;

// Tamaño de fuente fluido por nombre: entre más largo el nombre, más pequeño el máximo,
// para que siempre quepa en una sola línea dentro de su columna, sin recortarse ni desbordar.
function nameFontSize(name: string) {
    const cqw = Math.min(7, Math.max(4, 105 / name.length));
    const maxRem = Math.min(1.25, Math.max(0.85, 18 / name.length));
    return `clamp(0.75rem, ${cqw.toFixed(2)}cqw, ${maxRem.toFixed(2)}rem)`;
}
---

<Section id="invitacion" class="relative overflow-hidden py-16 min-h-screen">
    <!-- IMAGEN DE FONDO -->
    <div 
        class="absolute inset-0 bg-cover bg-center z-0" 
        style="background-image: url('https://plus.unsplash.com/premium_photo-1663076211121-36754a46de8d?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
    ></div>

    <!-- CAPA OSCURA / TRANSLÚCIDA (Overlay):
         Esto oscurece la foto de fondo para que el texto resalte.
         Puedes cambiar 'bg-black/40' por 'bg-white/70' si prefieres un fondo claro. -->
    <div class="absolute inset-0 bg-black/45 z-10"></div>

    <!-- CONTENIDO (Texto y ornamentos por encima de todo) -->
    <div class="relative z-20 text-white">
        <Ornament class="mb-10 brightness-0 invert" variant="top" />

        <div class="mx-auto max-w-2xl text-center px-6 py-10 sm:px-10 sm:py-16">
            <p class="font-serif text-2xl md:text-5xl leading-relaxed italic text-white drop-shadow-md">
                Con la bendición de Dios y la compañía de quienes amamos, tenemos el honor de invitarte a
                celebrar nuestra unión en matrimonio.
            </p>

            {
                showParents && (
                    <div class="mt-10 grid gap-8 font-label text-xs tracking-[0.15em] uppercase sm:grid-cols-2 text-white">
                        {showGroomParents && (
                            <div class="@container">
                                <p class="mb-2 text-champagne font-semibold text-lg md:text-2xl">Padres del novio</p>
                                {parents.groom.map((name) => (
                                    <p class="drop-shadow whitespace-nowrap" style={`font-size: ${nameFontSize(name)}`}>{name}</p>
                                ))}
                            </div>
                        )}
                        {showBrideParents && (
                            <div class="@container">
                                <p class="mb-2 text-champagne font-semibold text-lg md:text-2xl">Padres de la novia</p>
                                {parents.bride.map((name) => (
                                    <p class="drop-shadow whitespace-nowrap" style={`font-size: ${nameFontSize(name)}`}>{name}</p>
                                ))}
                            </div>
                        )}
                    </div>
                )
            }
        </div>

        <Ornament class="mt-10 brightness-0 invert" variant="bottom" />
    </div>
</Section>