---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import { couple, cierreNote } from '../../data/wedding';
import retratoElegante from '../../assets/fotos-boda/retrato-elegante-rasgada.jpg';
import detalleAnillo from '../../assets/fotos-boda/abrazo-sonrisa-rasgada.jpg';

const paragraphs = cierreNote.body.split('\n\n');
---

<Section id="cierre" background="ivory" class="relative overflow-hidden">
	<Ornament variant="corner-top-right" mirror class="opacity-90" />
	<Ornament variant="corner-bottom-left" mirror class="opacity-90" />

	<Ornament class="relative mb-8" variant="top" />

	<!--
		Díptico: dos retratos apenas girados en sentidos opuestos, como dos copias apoyadas
		una junto a la otra. El giro va en el contenedor y no en la imagen misma, para que el
		desfase vertical de la segunda (sm:mt-8) siga evitando que el par se lea como una tabla
		de dos celdas. Sin marco: ambas fotos ya vienen rasgadas y a su aspecto nativo.
	-->
	<div class="relative mx-auto mb-12 grid max-w-md grid-cols-2 gap-4 sm:gap-6">
		<div class="rotate-[-2.5deg]">
			<Image
				src={retratoElegante}
				alt={`Retrato de ${couple.groomFirstName} y ${couple.brideFirstName}`}
				quality="max"
				class="block h-auto w-full"
			/>
		</div>
		<div class="rotate-[2.5deg] sm:mt-8">
			<Image
				src={detalleAnillo}
				alt={`${couple.groomFirstName} y ${couple.brideFirstName} en un momento íntimo, mano con el anillo de compromiso`}
				quality="max"
				class="block h-auto w-full"
			/>
		</div>
	</div>

	<div class="relative mx-auto max-w-[55ch] text-center">
		<div class="space-y-4">
			{
				paragraphs.map((paragraph) => (
					<p class="font-serif text-xl leading-relaxed text-ink italic md:text-2xl">{paragraph}</p>
				))
			}
		</div>

		<blockquote class="mt-8 font-serif text-2xl text-dusty italic md:text-3xl">
			&ldquo;{cierreNote.verse}&rdquo;
		</blockquote>
		<cite class="mt-3 block font-label text-xs tracking-[0.2em] text-deep uppercase not-italic">
			{cierreNote.verseReference}
		</cite>
	</div>

	<Ornament class="relative mt-8" variant="bottom" />
</Section>
