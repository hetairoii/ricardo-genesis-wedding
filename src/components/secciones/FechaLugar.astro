---
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import LinkButton from '../LinkButton.astro';
import { weddingDateDisplay, venue } from '../../data/wedding';

const hasMapsUrl = venue.mapsUrl !== 'PENDIENTE';
---

<Section id="fecha-lugar" background="white">
	<div class="text-center" aria-hidden="true">
		<p class="font-script text-5xl text-champagne md:text-6xl">R&amp;G</p>
		<Ornament class="mt-4" />
	</div>

	<div class="mt-12 text-center">
		<p class="font-label text-xl tracking-[0.3em] text-deep uppercase">Ceremonia y festejo</p>
		<p class="mt-4 font-serif text-4xl text-ink">{venue.name}</p>
		<p class="mt-2 font-label text-xl text-deep">{venue.addressLine}</p>
		<p class="mt-2 font-label text-xl tracking-[0.2em] text-deep uppercase">
			{weddingDateDisplay.time} {weddingDateDisplay.timezone}
		</p>

		{
			hasMapsUrl && (
				<div class="mt-8 flex justify-center">
					<LinkButton href={venue.mapsUrl} external>
						Cómo llegar
					</LinkButton>
				</div>
			)
		}
	</div>
</Section>
