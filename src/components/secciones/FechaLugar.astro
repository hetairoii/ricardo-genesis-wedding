---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import LinkButton from '../LinkButton.astro';
import weddingArch from '../../assets/wedding-arch.png';
import { weddingDateDisplay, venue } from '../../data/wedding';

const hasMapsUrl = venue.mapsUrl !== 'PENDIENTE';
const [venueFirstWord, ...venueRestWords] = venue.name.split(' ');
const venueRest = venueRestWords.join(' ');
---

<Section id="fecha-lugar" background="white">
	<div class="text-center" aria-hidden="true">
		<Image src={weddingArch} alt="" class="mx-auto h-28 w-auto md:h-32" />
		<Ornament class="mt-4" variant="top" />
	</div>

	<div class="mt-12 text-center">
		<p class="font-label text-xl tracking-[0.3em] text-deep uppercase">Ceremonia y festejo</p>
		<p class="mt-4 font-serif text-4xl text-ink">
			{venueFirstWord}
			{venueRest && (
				<>
					<br />
					{venueRest}
				</>
			)}
		</p>
		<p class="mt-2 font-label text-xl text-deep">{venue.addressLine}</p>
		<p class="mt-2 font-label text-xl tracking-[0.2em] text-deep uppercase">
			{weddingDateDisplay.time} {weddingDateDisplay.timezone}
		</p>

		{
			hasMapsUrl && (
				<div class="mt-8 flex justify-center">
					<LinkButton href={venue.mapsUrl} external>
						Cómo llegar
					</LinkButton>
				</div>
			)
		}
	</div>
</Section>
