---
import PlaqueCard from '../contenedores/PlaqueCard.astro';
import Ornament from '../Ornament.astro';
import { couple } from '../../data/wedding';
---

<!--
	Ya no cuelga ninguna foto de aquí (se movió a `HeroFoto.astro`, la sección siguiente):
	solo queda la placa sobre el fondo `mist` liso. Sin foto ni cadenas no hace falta el
	wrapper `relative isolate` que antes evitaba que el z-index negativo de las cadenas se
	metiera detrás del fondo de la sección.
-->
<section
	id="hero"
	class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden bg-mist px-6 py-20"
>
	<Ornament variant="corner-top-right" class="opacity-90" />
	<Ornament variant="corner-bottom-left" class="opacity-90" />
	<Ornament variant="corner-top-right" mirror class="opacity-90" />
	<Ornament variant="corner-bottom-left" mirror class="opacity-90" />

	<PlaqueCard tone="deep" size="lg" class="relative w-[min(24rem,86vw)] shadow-md">
		<p class="font-label text-xs tracking-[0.35em] text-white/80 uppercase sm:text-sm">Nos casamos</p>

		<h1 id="hero-heading" tabindex="-1" class="mt-5 font-script text-5xl text-white sm:text-6xl focus:outline-none">
			{couple.groomFirstName}
			<span class="mx-2 inline-block align-middle text-champagne"> &amp; </span>
			{couple.brideFirstName}
		</h1>

		<p class="mt-5 font-label text-sm tracking-[0.3em] text-white/80">28 · 11 · 2026</p>
	</PlaqueCard>

	<div
		class="absolute bottom-8 left-1/2 -translate-x-1/2 text-deep motion-safe:animate-bounce"
		aria-hidden="true"
	>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</div>
</section>
