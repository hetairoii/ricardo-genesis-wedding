---
import PhotoSlot from '../PhotoSlot.astro';
import { couple } from '../../data/wedding';
---

<section id="hero" class="relative flex h-[100svh] items-center justify-center overflow-hidden">
	<div class="absolute inset-0">
		<PhotoSlot alt={`${couple.groom} y ${couple.bride}`} ratio="cover" priority class="h-full w-full" />
	</div>

	<!--
		Panel esmerilado detrás del texto, en vez de un velo a página completa: mantiene la foto
		visible (tono editorial) y a la vez garantiza contraste de texto sin importar qué foto llegue.
	-->
	<div class="relative rounded-sm bg-ivory/45 px-8 py-12 text-center backdrop-blur-sm sm:px-16 sm:py-16">
		<p class="font-label text-xs tracking-[0.35em] text-deep uppercase sm:text-sm">Nos casamos</p>
		<h1 id="hero-heading" tabindex="-1" class="mt-6 font-serif text-4xl text-ink sm:text-6xl focus:outline-none">
			{couple.groomFirstName}
			<span class="mx-2 inline-block align-middle font-script text-5xl text-dusty sm:text-7xl">&amp;</span>
			{couple.brideFirstName}
		</h1>
		<p class="mt-6 font-label text-sm tracking-[0.3em] text-deep">28 · 11 · 2026</p>
	</div>

	<div
		class="absolute bottom-8 left-1/2 -translate-x-1/2 text-deep motion-safe:animate-bounce"
		aria-hidden="true"
	>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</div>
</section>
