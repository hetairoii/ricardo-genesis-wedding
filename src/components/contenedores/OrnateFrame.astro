---
/*
	Marco de filete fino con florituras botánicas en las esquinas -- el contenedor de "tarjeta"
	de la referencia (bloque de regalos, horarios, etc.).

	Las florituras son SVG de línea (no las flores acuarela): a este tamaño una imagen raster se
	vería sucia, y al ser trazo con currentColor la esquina se tiñe sola según el tono del marco.
	Se dibuja UNA sola rama y se repite 4 veces reflejada/rotada, así las cuatro esquinas casan.
*/
interface Props {
	/** 'light' = tarjeta blanca · 'ivory' = marfil · 'deep' = azul con filete claro. */
	tone?: 'light' | 'ivory' | 'deep';
	/** Tamaño de las florituras de esquina. */
	ornamentSize?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { tone = 'light', ornamentSize = 'md', class: className } = Astro.props;

const tones = {
	light: 'border-champagne bg-white text-ink',
	ivory: 'border-champagne bg-ivory text-ink',
	deep: 'border-white/40 bg-deep text-white',
}[tone];

const ornamentClass = {
	sm: 'h-8 w-8 sm:h-10 sm:w-10',
	md: 'h-12 w-12 sm:h-14 sm:w-14',
	lg: 'h-16 w-16 sm:h-20 sm:w-20',
}[ornamentSize];

// Cada esquina reusa la misma rama: reflejada en X, en Y, o rotada 180°.
const corners = [
	{ place: 'top-1 left-1', flip: '' },
	{ place: 'top-1 right-1', flip: '-scale-x-100' },
	{ place: 'bottom-1 left-1', flip: '-scale-y-100' },
	{ place: 'bottom-1 right-1', flip: 'rotate-180' },
];
---

<div class:list={['relative border px-8 py-10 text-center sm:px-12 sm:py-12', tones, className]}>
	{
		corners.map((corner) => (
			<svg
				class:list={['pointer-events-none absolute opacity-70', corner.place, corner.flip, ornamentClass]}
				viewBox="0 0 64 64"
				fill="none"
				stroke="currentColor"
				aria-hidden="true"
				focusable="false"
			>
				<path d="M2 2 C 20 5, 33 13, 42 29" stroke-width="0.9" stroke-linecap="round" />
				<path d="M6 3 C 12 14, 12 24, 8 34" stroke-width="0.7" stroke-linecap="round" />

				<ellipse cx="14.6" cy="5.2" rx="5.4" ry="2.3" fill="currentColor" stroke="none" transform="rotate(20 14.6 5.2)" />
				<ellipse cx="25.4" cy="10.6" rx="5" ry="2.1" fill="currentColor" stroke="none" transform="rotate(35 25.4 10.6)" />
				<ellipse cx="34.5" cy="18.5" rx="4.4" ry="1.9" fill="currentColor" stroke="none" transform="rotate(52 34.5 18.5)" />
				<ellipse cx="10.5" cy="16" rx="4.2" ry="1.8" fill="currentColor" stroke="none" transform="rotate(78 10.5 16)" />
				<ellipse cx="10" cy="27" rx="3.6" ry="1.6" fill="currentColor" stroke="none" transform="rotate(100 10 27)" />

				<circle cx="41.5" cy="29" r="1.5" fill="currentColor" stroke="none" />
				<circle cx="8" cy="34.5" r="1.2" fill="currentColor" stroke="none" />
			</svg>
		))
	}

	<div class="relative">
		<slot />
	</div>
</div>
