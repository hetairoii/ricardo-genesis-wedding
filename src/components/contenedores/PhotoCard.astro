---
/*
	Tarjeta-marco para una foto: paspartú (el borde ancho de cartón de un cuadro enmarcado)
	+ filete + hueco de foto. Envuelve a PhotoSlot en vez de sustituirlo, así el sitio sigue
	teniendo UN solo lugar donde se decide qué se ve mientras no hay foto real (el placeholder
	con el monograma) y cómo se optimiza cuando llegue.

	Por eso PhotoSlot va aquí con `innerBorder={false}`: su filete propio y el del marco se
	verían como dos líneas paralelas casi pegadas.

	`shape="arch"` redondea SOLO la parte de arriba, y el redondeo del hueco interior es menor
	que el del marco a propósito -- dos arcos concéntricos con el mismo radio se cruzarían en
	los flancos y el paspartú se vería más fino arriba que a los lados.
*/
import type { ImageMetadata } from 'astro';
import PhotoSlot from '../PhotoSlot.astro';

interface Props {
	/** Cuando llegue la foto real: `import foto from '../../assets/foto.jpg'` y pasarla aquí. */
	src?: ImageMetadata;
	/** Obligatorio aunque todavía no haya `src`. */
	alt: string;
	ratio?: 'portrait' | 'landscape' | 'square';
	/** 'arch' = medio punto arriba · 'square' = rectangular. */
	shape?: 'arch' | 'square';
	/** 'gold' = filete dorado (acento nuevo) · 'light' / 'ivory' / 'deep' = paleta fría. */
	tone?: 'gold' | 'light' | 'ivory' | 'deep';
	/** Pie de foto opcional, en versalitas bajo el marco. */
	caption?: string;
	priority?: boolean;
	/** Blanco y negro, para unificar tono con el resto de fotos reales del sitio. */
	bw?: boolean;
	/** Punto de enfoque del recorte. 'top' evita cortar cabezas en fotos verticales dentro de huecos más anchos que altos. */
	focus?: 'center' | 'top';
	class?: string;
}

const {
	src,
	alt,
	ratio = 'portrait',
	shape = 'square',
	tone = 'gold',
	caption,
	priority = false,
	bw = false,
	focus = 'center',
	class: className,
} = Astro.props;

const tones = {
	gold: { frame: 'photo-card-frame--gold', caption: 'text-deep' },
	light: { frame: 'border border-champagne bg-white', caption: 'text-deep' },
	ivory: { frame: 'border border-champagne bg-ivory', caption: 'text-deep' },
	deep: { frame: 'border border-white/40 bg-deep', caption: 'text-white/80' },
}[tone];

const outerShape = shape === 'arch' ? 'rounded-t-[999px]' : 'rounded-sm';
const innerShape = shape === 'arch' ? 'rounded-t-[999px]' : 'rounded-[2px]';
---

<figure class:list={['relative', className]}>
	<div class:list={['relative p-1.5 shadow-sm sm:p-2', outerShape, tones.frame]}>
		<div class:list={['overflow-hidden', innerShape]}>
			<PhotoSlot
				src={src}
				alt={alt}
				ratio={ratio}
				priority={priority}
				innerBorder={false}
				bw={bw}
				focus={focus}
				class="w-full"
			/>
		</div>
	</div>

	{
		caption && (
			<figcaption class:list={['mt-4 text-center font-label text-xs tracking-[0.25em] uppercase', tones.caption]}>
				{caption}
			</figcaption>
		)
	}
</figure>

<style>
	/*
		Metal, no color plano: el degradado en diagonal con las paradas claras y oscuras
		alternadas es lo que hace que el marco lea como dorado y no como un beige.
		Los hex viven en los tokens --color-gold* (src/styles/global.css), no aquí.
	*/
	.photo-card-frame--gold {
		background-image: linear-gradient(
			135deg,
			var(--color-gold-dark) 0%,
			var(--color-gold-light) 22%,
			var(--color-gold) 45%,
			var(--color-gold-light) 68%,
			var(--color-gold-dark) 100%
		);
	}
</style>
