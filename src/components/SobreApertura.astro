---
import Ornament from './Ornament.astro';
import { couple, weddingDateDisplay } from '../data/wedding';
---

<div
	id="sobre-apertura"
	class="fixed inset-0 z-50 flex-col items-center justify-center gap-8 overflow-y-auto bg-ivory px-6 py-10"
	role="dialog"
	aria-modal="true"
	aria-labelledby="sobre-nombres"
>
	<!-- Ornamentos florales: mismo motivo de esquina que el resto del sitio, para que el
	     primer elemento que ve el invitado use el mismo lenguaje visual. -->
	<Ornament variant="corner-top-right" class="pointer-events-none !w-20 opacity-90 sm:!w-28 md:!w-36" />
	<Ornament variant="corner-bottom-left" class="pointer-events-none !w-24 opacity-90 sm:!w-32 md:!w-44" />

	<!-- Vistazo previo: mismos datos que el resto de la invitación, no escritos a mano. -->
	<div class="relative text-center">
		<p class="font-label text-xs tracking-[0.35em] text-deep uppercase">Nuestra boda</p>
		<p id="sobre-nombres" class="mt-3 font-script text-4xl text-ink sm:text-5xl">
			{couple.groomFirstName} <span class="text-dusty">&amp;</span> {couple.brideFirstName}
		</p>
		<p class="mt-3 font-label text-xs tracking-[0.3em] text-deep uppercase">
			{weddingDateDisplay.day} · {weddingDateDisplay.month} · {weddingDateDisplay.year}
		</p>
	</div>

	<button
		id="sobre-boton"
		type="button"
		class="relative flex flex-col items-center gap-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-deep"
	>
		<span class="sobre-visual">
			<svg viewBox="0 0 240 160" overflow="visible" aria-hidden="true">
				<defs>
					<clipPath id="sobre-clip">
						<rect x="10" y="20" width="220" height="120" rx="4" />
					</clipPath>
					<linearGradient id="sobre-body-gradient" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0%" stop-color="var(--color-sand)" />
						<stop offset="100%" stop-color="var(--color-sand-deep)" />
					</linearGradient>
					<linearGradient id="sobre-flap-gradient" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="var(--color-sand)" />
						<stop offset="100%" stop-color="var(--color-sand-deep)" />
					</linearGradient>
					<radialGradient id="sobre-wax-gradient" cx="35%" cy="30%" r="75%">
						<stop offset="0%" stop-color="var(--color-sky)" />
						<stop offset="55%" stop-color="var(--color-wax)" />
						<stop offset="100%" stop-color="var(--color-ink)" />
					</radialGradient>
					<marker
						id="sobre-arrowhead"
						viewBox="0 0 10 10"
						refX="6"
						refY="5"
						markerWidth="6"
						markerHeight="6"
						orient="auto-start-reverse"
					>
						<path d="M0 0 L10 5 L0 10 Z" fill="var(--color-dusty)" />
					</marker>
				</defs>

				<rect
					x="10"
					y="20"
					width="220"
					height="120"
					rx="4"
					fill="url(#sobre-body-gradient)"
					stroke="var(--color-sand-deep)"
					stroke-width="1.5"
				/>

				<!-- Pliegues laterales insinuados, para que el sobre no se lea plano. -->
				<path d="M10 140 L75 95" fill="none" stroke="var(--color-sand-deep)" stroke-width="1" opacity="0.6" />
				<path d="M230 140 L165 95" fill="none" stroke="var(--color-sand-deep)" stroke-width="1" opacity="0.6" />

				<g clip-path="url(#sobre-clip)">
					<rect
						id="sobre-card"
						x="35"
						y="35"
						width="170"
						height="90"
						rx="3"
						fill="var(--color-ivory)"
						stroke="var(--color-periwinkle)"
						stroke-width="1"
					/>
				</g>

				<g class="sobre-flap-group">
					<path
						d="M10 20 L120 90 L230 20 Z"
						fill="url(#sobre-flap-gradient)"
						stroke="var(--color-sand-deep)"
						stroke-width="1.5"
						stroke-linejoin="round"
					/>
					<!-- Sello en la punta de la solapa (donde iría un lacre real), dentro del grupo
					     que rota: gira con la solapa al abrirse. -->
					<circle cx="120" cy="90" r="17" fill="url(#sobre-wax-gradient)" stroke="var(--color-ink)" stroke-width="0.5" />
					<circle cx="113" cy="83" r="4" fill="var(--color-white)" opacity="0.25" />
					<text
						x="120"
						y="95.5"
						text-anchor="middle"
						font-size="14"
						fill="var(--color-white)"
						style="font-family: var(--font-script);"
					>
						R&amp;G
					</text>
				</g>

				<!-- Flecha señalando el sello; se desvanece apenas empieza la apertura. -->
				<path
					class="sobre-arrow"
					d="M190 128 Q165 118 142 100"
					fill="none"
					stroke="var(--color-dusty)"
					stroke-width="1.5"
					stroke-dasharray="4 4"
					stroke-linecap="round"
					marker-end="url(#sobre-arrowhead)"
				/>
			</svg>
		</span>

		<span class="font-label text-xs tracking-[0.25em] text-deep uppercase">
			Toca el sobre para abrir tu invitación
		</span>
	</button>

	<!-- Lugares reservados: oculto por defecto, solo lo revela src/scripts/guest-params.ts
	     cuando el enlace trae ?invitado= y ?pases= válidos. -->
	<div id="sobre-pases" class="relative text-center" hidden>
		<p class="font-label text-xs tracking-[0.3em] text-deep uppercase">Hemos reservado</p>
		<div class="mx-auto mt-2 flex h-14 w-14 items-center justify-center rounded-full border-2 border-champagne">
			<span id="sobre-pases-numero" class="font-serif text-2xl text-ink"></span>
		</div>
		<p class="mt-2 font-label text-xs tracking-[0.3em] text-deep uppercase">lugares en su honor</p>
	</div>
</div>

<audio id="sobre-audio" preload="none" loop>
	<source src="/music.mp3" type="audio/mpeg" />
</audio>

<style>
	.sobre-visual {
		display: block;
		width: min(70vw, 240px);
		perspective: 700px;
	}

	.sobre-visual svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 10px 18px rgba(46, 58, 79, 0.18));
	}
</style>

<script>
	import '../scripts/sobre-apertura.ts';
	import '../scripts/guest-params.ts';
</script>
